{
  "manifest_version": 3,
  "name": "haxefmod for FMOD docs",
  "version": "2.0.0",
  "description": "Adds a Haxe tab to the FMOD API reference showing the haxefmod method for every function.",
  "homepage_url": "https://github.com/Tanz0rz/haxe-fmod",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.fmod.com/docs/*", "https://fmod.com/docs/*"],
      "js": ["bindings-data.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "haxefmod-docs@haxe-fmod.tanz0rz.github.io",
      "strict_min_version": "109.0"
    }
  }
}
