<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- templatePath copies pre-built hdlls into HL build output automatically -->
	<templatePath name="templates" />

	<!-- C++ postbuild: copy FMOD runtime libs from $FMOD_SDK -->
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh mac cpp" if="mac" unless="hl html5" />
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh linux cpp" if="linux" unless="hl html5" />
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh windows cpp" if="windows" unless="hl html5" />

	<!-- HL postbuild: copy FMOD runtime libs for HashLink targets -->
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh mac hl" if="mac hl" unless="html5" />
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh linux hl" if="linux hl" unless="html5" />
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh windows hl" if="windows hl" unless="html5" />

	<!-- HTML5 dependencies -->
	<dependency path="${FMOD_SDK}/html5/api/core/lib/upstream/wasm/fmodstudio.js" if="html5"/>
	<assets path="${FMOD_SDK}/html5/api/core/lib/upstream/wasm/fmodstudio.wasm" rename="lib/fmodstudio.wasm" if="html5"/>
	<dependency path="native/jaxe/jaxe.js" if="html5"/>
</project>
