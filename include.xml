<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- Compile-time environment validation -->
	<haxeflag name="--macro" value="haxefmod.FmodBuildMacro.checkEnvironment()" />

	<!-- templatePath copies pre-built hdlls into HL build output automatically -->
	<templatePath name="templates" />

	<!-- C++ postbuild: copy FMOD runtime libs from $FMOD_SDK -->
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh mac cpp" if="mac" unless="hl" />
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh linux cpp" if="linux" unless="hl" />
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh windows cpp" if="windows" unless="hl" />

	<!-- HL postbuild: copy FMOD runtime libs for HashLink targets -->
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh mac hl" if="mac hl" unless="html5" />
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh linux hl" if="linux hl" unless="html5" />
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh windows hl" if="windows hl" unless="html5" />

	<!-- HTML5 postbuild: copy FMOD WebAssembly files -->
	<postbuild command="bash ${haxelib:haxefmod}/scripts/postbuild-copy-fmod.sh html5 html5" if="html5" />

	<!-- HTML5 JS dependency (jaxe.js - our wrapper code) -->
	<dependency path="native/jaxe/jaxe.js" if="html5"/>
</project>
