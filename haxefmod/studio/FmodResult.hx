        "FMOD_ERR_HEADER_MISMATCH", "FMOD_ERR_HTTP", "FMOD_ERR_HTTP_ACCESS", "FMOD_ERR_HTTP_PROXY_AUTH",
        "FMOD_ERR_HTTP_SERVER_ERROR", "FMOD_ERR_HTTP_TIMEOUT", "FMOD_ERR_INITIALIZATION", "FMOD_ERR_INITIALIZED",
