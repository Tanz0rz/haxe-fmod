    var FMOD_OK = 0;
    var FMOD_ERR_BADCOMMAND = 1;
    var FMOD_ERR_CHANNEL_ALLOC = 2;
    var FMOD_ERR_CHANNEL_STOLEN = 3;
    var FMOD_ERR_DMA = 4;
