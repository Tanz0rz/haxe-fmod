    var FMOD_ERR_HTTP_ACCESS = 22;
    var FMOD_ERR_HTTP_PROXY_AUTH = 23;
    var FMOD_ERR_HTTP_SERVER_ERROR = 24;
    var FMOD_ERR_HTTP_TIMEOUT = 25;
