# Browser build: build/html5/game.js, loaded by index.html after the FMOD engine scripts
-cp src
-cp ../shared
-lib heaps
-lib haxefmod
-main Main
-resource ../EZPlatformer/assets/level.csv@level
--macro haxefmod.tools.BuildCheck.verify()
# The api-probe calls methods FMOD's web build cannot serve on purpose and checks the FMOD_ERR_UNSUPPORTED results at runtime
-D haxefmod_html5_allow_unsupported
-js build/html5/game.js
